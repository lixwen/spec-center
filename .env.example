# ---- MongoDB ----
MONGO_ROOT_USERNAME=openspec
MONGO_ROOT_PASSWORD=changeme_root
MONGO_APP_USERNAME=openspec_app
MONGO_APP_PASSWORD=changeme_app
OPENSPEC_MONGODB_DB=spec-center
# Local dev (non-Docker):
# OPENSPEC_MONGODB_URL=mongodb://openspec_app:changeme_app@127.0.0.1:27017/spec-center?authSource=spec-center

# ---- Qdrant ----
# Local dev (non-Docker):
# QDRANT_URL=http://localhost:6333

# ---- AI (OpenAI-compatible endpoint) ----
AI_API_KEY=your-api-key-here
AI_BASE_URL=https://openrouter.ai/api/v1
AI_EMBEDDING_MODEL=intfloat/multilingual-e5-large
AI_CHAT_MODEL=anthropic/claude-sonnet-4
# AI_RERANK_MODEL=cohere/rerank-4-fast
# AI_RERANK_ENABLED=true

# ---- Auth (optional) ----
# OPENSPEC_JWT_SECRET=your-jwt-secret
# OPENSPEC_BOOTSTRAP_ADMIN_PASSWORD=admin123
# OPENSPEC_BOOTSTRAP_ADMIN_USERNAME=admin
