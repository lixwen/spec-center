{
  "name": "@spec-center/core",
  "version": "0.1.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean && mkdir -p dist/eval && cp -r src/eval/datasets dist/eval/",
    "prepack": "npm run build",
    "lint": "tsc --project tsconfig.json --noEmit",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "worker": "tsx src/worker-main.ts"
  },
  "dependencies": {
    "@qdrant/js-client-rest": "^1.17.0",
    "mongodb": "^7.1.1",
    "openai": "^6.34.0",
    "pino": "^10.3.1",
    "zod": "^4.3.6"
  }
}
